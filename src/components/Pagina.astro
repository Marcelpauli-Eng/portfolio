---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Programa from './Programa.astro';
import { textos, EMAIL, WHATSAPP, type Lang } from '../textos';
import { programas } from '../programas';
import { ahorro } from '../ahorro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = textos[lang];
const progs = programas[lang];

const capturas = import.meta.glob<{ default: ImageMetadata }>('../assets/capturas/*.png', { eager: true });
const img = (nombre: string) => capturas[`../assets/capturas/${nombre}.png`].default;

const inicio = lang === 'es' ? '/' : '/ca/';
const wa = WHATSAPP ? `https://wa.me/${WHATSAPP}` : null;

// Cada oficio en el aparato en el que se usa, con sus herramientas alrededor.
// Herramientas: [nombre, x, y, ancho (en % de la escena), giro, lado por el que entra].
type Herr = [string, string, string, string, string, number];
const escenas: Record<string, { aparato: string; widths: number[]; sizes: string; herr: Herr[] }> = {
  talleres: {
    aparato: 'tablet', widths: [340, 680], sizes: '340px',
    herr: [['llave', '2.4%', '81.5%', '43%', '-16deg', -1], ['bujia', '82.3%', '10.4%', '8%', '16deg', 1], ['pinon', '77.5%', '62.3%', '20%', '0deg', 1]],
  },
  lampistas: {
    aparato: 'portatil', widths: [600, 1200], sizes: '(min-width: 1024px) 600px, calc(100vw - 52px)',
    herr: [['grifa', '3.8%', '0.8%', '34.9%', '-4deg', -1], ['grifo', '46%', '-0.8%', '17.4%', '0deg', 1], ['codo', '77.5%', '-3%', '16%', '0deg', 1]],
  },
  transportistas: {
    aparato: 'movil', widths: [232, 464], sizes: '232px',
    herr: [['camion', '1.1%', '68%', '40%', '-3deg', -1], ['caja', '70.8%', '69%', '20%', '0deg', 1], ['ruta', '66.8%', '6.5%', '30.8%', '0deg', 1]],
  },
};

// Iconos de los servicios, dibujados a línea como las herramientas.
const iconos: Record<string, string> = {
  medida: '<rect x="4" y="7" width="40" height="30" rx="3"></rect><path d="M4 14h40"></path><rect x="10" y="20" width="12" height="11" rx="1"></rect><path d="M28 21h10M28 26h10M28 31h6M18 43h12M24 37v6"></path>',
  verifactu: '<path d="M10 4h21l8 8v32H10z"></path><path d="M31 4v8h8M15 17h12M15 23h17"></path><rect x="15" y="29" width="9" height="9" rx="1"></rect><path d="M28 29h4v4M28 37h4M34 33v4"></path>',
  movil: '<rect x="13" y="3" width="22" height="42" rx="4"></rect><path d="M21 39h6M18 18a8.5 8.5 0 0 1 12 0M21 22a4 4 0 0 1 6 0M16 12l16 16"></path>',
  soporte: '<rect x="4" y="13" width="25" height="23" rx="3"></rect><path d="M9 30h7M4 21h25"></path><path d="M37 13l8 3v7c0 6-3.6 10-8 12-4.4-2-8-6-8-12v-7z"></path><path d="M33.5 23.5l2.5 2.5 4.5-5"></path>',
  // Los de «Tu trabajo, bajo control».
  dia: '<rect x="5" y="9" width="38" height="34" rx="3"></rect><path d="M5 18h38M15 5v8M33 5v8M17 30l5 5 10-11"></path>',
  estado: '<path d="M19 12h23M19 24h23M19 36h23M5 12l3 3 5-6M5 24l3 3 5-6"></path><circle cx="9" cy="36" r="3.5"></circle>',
  material: '<path d="M24 4l18 9v22L24 44 6 35V13z"></path><path d="M6 13l18 9 18-9M24 22v22M15 8.5l18 9"></path>',
  numeros: '<path d="M5 43h38M11 43V27M20 43V15M29 43V31M38 43V21"></path>',
};

// La cuenta del ahorro con los valores de partida; el script la rehace al mover los controles.
const valores = Object.fromEntries(t.tiempo.campos.map((c) => [c.id, c.valor]));
const cuenta = ahorro(valores, lang);

const enlaces = [
  ['#programas', t.nav.proyectos],
  ['#servicios', t.nav.servicios],
  ['#como-trabajo', t.nav.como],
  ['#contacto', t.nav.contacto],
];
const iconoWa = '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>';
const check = '<path d="M4 10.5l4 4 8-9"></path>';
---
<Base lang={lang}>
  <a class="saltar" href="#contenido">{t.nav.saltar}</a>

  <header class="cabecera envoltorio">
    <a class="marca" href={inicio}>Automaittech</a>
    <nav class="nav" aria-label={t.nav.principal}>
      <ul class="nav-enlaces">
        {enlaces.map(([href, texto]) => <li><a href={href}>{texto}</a></li>)}
      </ul>
      <details class="nav-menu">
        <summary>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          {t.nav.menu}
        </summary>
        <ul>
          {enlaces.map(([href, texto]) => <li><a href={href}>{texto}</a></li>)}
        </ul>
      </details>
      <div class="idiomas">
        <a href="/" lang="es" hreflang="es" aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
        <a href="/ca/" lang="ca" hreflang="ca" aria-current={lang === 'ca' ? 'page' : undefined}>CA</a>
      </div>
    </nav>
  </header>

  <main id="contenido">
    <section class="hero envoltorio">
      <div class="hero-texto">
        <h1>{t.hero.h1}</h1>
        <p class="entradilla">{t.hero.p}</p>
        <div class="botones">
          <a class="boton" href="#contacto">{t.hero.demo}</a>
          {wa && (
            <a class="boton boton--linea" href={wa}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconoWa}></svg>
              {t.hero.whatsapp}
            </a>
          )}
        </div>
      </div>

      <div class="hero-escena">
        <div class="copia copia--rosa"></div>
        <div class="copia copia--amarilla"></div>
        <div class="hoja" role="img" aria-label={t.hero.hojaAlt}>
          <div class="perforado"></div>
          <div class="hoja-cuerpo">
            <div class="hoja-cabecera"><span>{t.hoja.titulo}</span><span class="numero">Nº 0098</span></div>
            <div class="campo"><span class="etq">{t.hoja.fecha}</span><span class="valor">lun 21 sept</span></div>
            <div class="campo"><span class="etq">{t.hoja.cliente}</span><span class="valor">Antonio García Ruiz</span></div>
            <div class="campo"><span class="etq">{t.hoja.telefono}</span><span class="valor">600 100 104</span></div>
            <div class="campo"><span class="etq">{t.hoja.direccion}</span><span class="valor">Av. de Blondel 7, Lleida</span></div>
            <div class="campo"><span class="etq">{t.hoja.trabajo}</span><span class="valor">Reparación de termo eléctrico</span></div>
            <div class="campo campo--notas"><span class="etq">{t.hoja.notas}</span><span class="valor">No calienta y salta el diferencial.</span></div>
            <div class="firma">
              <div class="firma-trazo">
                <svg viewBox="0 0 200 56" fill="none" stroke="#2448B8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 42c10-30 26-34 22-8s14 18 22-6 12-14 10 6 18 6 26-12 10-6 12 8 20 2 40-10l34 4"></path><path d="M60 50c30-4 70-6 120-4"></path></svg>
                <span class="firma-tapa"></span>
              </div>
              <span class="etq">{t.hoja.firma}</span>
            </div>
          </div>
        </div>
        <div class="hero-movil">
          <div class="hero-movil-pantalla">
            <Picture src={img('codo90-movil-parte')} alt={t.hero.movilAlt} widths={[280, 560]} sizes="(min-width: 1024px) 280px, 44vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <section id="control" class="control envoltorio" aria-labelledby="t-control">
      <div class="control-texto">
        <h2 id="t-control">{t.control.h2}</h2>
        <p class="entradilla">{t.control.p}</p>
      </div>

      <div class="tabla-escena" role="img" aria-label={t.control.tablaAlt}>
        <div class="tabla">
          <svg class="tabla-pinza" viewBox="0 0 120 44" fill="#E1E4DC" stroke="#1B2A4A" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M38 18v-4a22 12 0 0 1 44 0v4"></path><rect x="6" y="18" width="108" height="22" rx="6"></rect><circle cx="60" cy="12" r="3.6" fill="#1B2A4A"></circle><path d="M18 29h84" fill="none" stroke-width="1.2" opacity=".5"></path></svg>
          <div class="tabla-hoja">
            <div class="perforado"></div>
            <div class="tabla-cuerpo">
              <p class="tabla-cab"><span>{t.control.hoja}</span><span class="numero">{t.control.avisos.filter((a) => a.estado === 'hecho').length}/{t.control.avisos.length}</span></p>
              {t.control.avisos.map((a) => (
                <div class="aviso">
                  <time>{a.hora}</time>
                  <span><strong>{a.t}</strong><small>{a.d}</small></span>
                  <span class={`aviso-estado aviso-estado--${a.estado}`}>
                    {a.estado === 'hecho' && <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check}></svg>}
                    {t.control.estados[a.estado as keyof typeof t.control.estados]}
                  </span>
                </div>
              ))}
              <p class="tabla-pie">{t.control.pie.map(([etq, valor]) => <span>{etq}: <em>{valor}</em></span>)}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="control-remate">
        <ul class="puntos-control">
          {t.control.puntos.map((p) => (
            <li>
              <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[p.icono]}></svg>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))}
        </ul>
        <a class="boton" href="#contacto">{t.hero.demo}</a>
      </div>
    </section>

    <section id="ahorro" class="ahorro" aria-labelledby="t-ahorro">
      <div class="envoltorio ahorro-rejilla">
        <div class="ahorro-texto">
          <h2 id="t-ahorro">{t.tiempo.h2}</h2>
          <p class="entradilla">{t.tiempo.intro}</p>
        </div>

        <form class="ticket ticket--ahorro" data-lang={lang} onsubmit="return false">
          <div class="perforado"></div>
          <div class="ticket-cuerpo">
            <p class="ticket-titulo">{t.tiempo.ticket}</p>
            {t.tiempo.campos.map((c) => (
              <div class="regla">
                <label for={`a-${c.id}`}>{c.t}</label>
                <output for={`a-${c.id}`} id={`v-${c.id}`}>{String(c.valor).replace('.', ',')} {c.ud}</output>
                <input type="range" id={`a-${c.id}`} name={c.id} min={c.min} max={c.max} step={c.paso} value={c.valor} data-ud={c.ud} />
              </div>
            ))}
            <div class="ticket-total" aria-live="polite">
              <p class="ticket-total-etq">{t.tiempo.total}</p>
              <p class="ticket-cifra"><span data-salida="semana">{cuenta.semana}</span> <small>{t.tiempo.semana}</small></p>
              <p class="ticket-sub"><span data-salida="mes">{cuenta.mes}</span> {t.tiempo.mes}</p>
              <p class="ticket-sub"><span data-salida="anyo">{cuenta.anyo}</span> {t.tiempo.anyo}</p>
            </div>
            <p class="ticket-nota">{t.tiempo.nota}</p>
          </div>
        </form>
      </div>
    </section>

    <section id="programas" class="programas" data-activo={progs[0].id} aria-labelledby="t-programas">
      <div class="fondos" aria-hidden="true">
        {progs.map((p, i) => <span class:list={['fondo', `fondo--${p.id}`, { activo: i === 0 }]}></span>)}
      </div>

      <div class="envoltorio programas-cabecera">
        <h2 id="t-programas">{t.proyectos.h2}</h2>
        <p class="entradilla">{t.proyectos.intro}</p>
      </div>

      <div class="carrusel">
        <div class="carrusel-barra">
          <div class="envoltorio carrusel-barra-int">
            <div class="pestanas" role="tablist" aria-label={t.proyectos.programas}>
              {progs.map((p, i) => (
                <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={p.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                  <span class="pestana-oficio">{p.tab}</span>
                  <span class="pestana-nombre">{p.nombre}</span>
                </button>
              ))}
            </div>
            <div class="flechas">
              <p class="contador"><span class="contador-n">1</span> {t.proyectos.de} {progs.length}</p>
              <button type="button" class="flecha" data-dir="-1" aria-label={t.proyectos.anterior}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
              </button>
              <button type="button" class="flecha" data-dir="1" aria-label={t.proyectos.siguiente}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="envoltorio carrusel-pista">
          {progs.map((p, i) => <Programa p={p} activo={i === 0} t={t.proyectos} escena={escenas[p.id]} img={img} />)}
        </div>
      </div>
    </section>

    <section id="servicios" class="servicios envoltorio" aria-labelledby="t-servicios">
      <h2 id="t-servicios">{t.servicios.h2}</h2>
      <ul class="servicios-lista">
        {t.servicios.items.map((s) => (
          <li class="servicio">
            <svg class="servicio-icono" viewBox="0 0 48 48" width="56" height="56" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[s.icono]}></svg>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="como-trabajo" class="proceso" aria-labelledby="t-proceso">
      <div class="envoltorio">
        <h2 id="t-proceso">{t.proceso.h2}</h2>
        <ol class="pasos" role="list">
          {t.proceso.pasos.map((p, i) => (
            <li><span class="paso-num" aria-hidden="true">{i + 1}</span><h3>{p.t}</h3><p>{p.d}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="contacto" class="contacto" aria-labelledby="t-contacto">
      <div class="envoltorio contacto-rejilla">
        <div class="contacto-texto">
          <h2 id="t-contacto">{t.contacto.h2}</h2>
          <p class="entradilla">{t.contacto.p}</p>
          <dl class="canales">
            <div>
              <dt>{t.contacto.whatsapp}</dt>
              <dd>{wa ? <a href={wa}>{t.hero.whatsapp}</a> : <span class="falta">{t.contacto.whatsappFalta}</span>}</dd>
            </div>
            <div><dt>{t.contacto.correo}</dt><dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd></div>
          </dl>
        </div>

        <!-- ponytail: FormSubmit reenvía el formulario a EMAIL sin servidor ni claves. El primer envío manda a EMAIL un correo para activarlo. Si un día hace falta más control, un endpoint propio (Vercel + Resend). -->
        <form class="parte" action={`https://formsubmit.co/${EMAIL}`} method="post" data-email={EMAIL} data-asunto={t.contacto.asunto} data-hecho={t.contacto.hecho} data-error={t.contacto.error}>
          <input type="hidden" name="_subject" value={t.contacto.asunto} />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" class="trampa" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="perforado"></div>
          <div class="parte-cuerpo">
            <div class="campo-form">
              <label class="etq" for="f-nombre">{t.contacto.nombre}</label>
              <input id="f-nombre" name="nombre" autocomplete="name" required />
            </div>
            <div class="campo-form">
              <label class="etq" for="f-oficio">{t.contacto.oficio}</label>
              <select id="f-oficio" name="oficio">
                {t.contacto.oficios.map((o) => <option>{o}</option>)}
              </select>
            </div>
            <div class="campo-form campo-form--ancho">
              <label class="etq" for="f-contacto">{t.contacto.contacto}</label>
              <input id="f-contacto" name="contacto" required />
            </div>
            <div class="campo-form campo-form--ancho">
              <label class="etq" for="f-mensaje">{t.contacto.mensaje}</label>
              <textarea id="f-mensaje" name="mensaje" rows="3"></textarea>
            </div>
            <div class="campo-form--ancho parte-enviar">
              <button class="boton" type="submit">{t.contacto.enviar}</button>
              <p class="hecho" role="status"></p>
            </div>
          </div>
          <span class="sello" aria-hidden="true">{t.contacto.sello}</span>
        </form>
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="envoltorio pie-rejilla">
      <div class="pie-marca">
        <p class="marca">Automaittech</p>
        <p>{t.pie.lema}</p>
      </div>
      <nav aria-label={t.nav.principal}>
        <ul>{enlaces.map(([href, texto]) => <li><a href={href}>{texto}</a></li>)}</ul>
      </nav>
      <div class="pie-contacto">
        <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        <p>{t.contacto.dondeValor}</p>
        <p class="pie-idiomas">
          <a href="/" lang="es" hreflang="es" aria-current={lang === 'es' ? 'page' : undefined}>Castellano</a>
          <a href="/ca/" lang="ca" hreflang="ca" aria-current={lang === 'ca' ? 'page' : undefined}>Català</a>
        </p>
      </div>
    </div>
    <div class="envoltorio pie-final"><p>{t.pie.derechos}</p></div>
  </footer>

  <script>
    import '../scripts/movimiento';
  </script>
</Base>
