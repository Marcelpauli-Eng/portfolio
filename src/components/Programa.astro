---
import { statSync } from 'node:fs';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Herramienta from './Herramienta.astro';
import type { Programa } from '../programas';

type Herr = [string, string, string, string, string, number];
interface Props {
  p: Programa;
  activo: boolean;
  t: { pantallas: string; pista: string; mas: string; folleto: string };
  escena: { aparato: string; widths: number[]; sizes: string; herr: Herr[] };
  img: (nombre: string) => ImageMetadata;
}
const { p, activo, t, escena: e, img } = Astro.props;
const formatos: ('avif' | 'webp')[] = ['avif', 'webp'];
const check = '<path d="M4 10.5l4 4 8-9"></path>';
const portadas = import.meta.glob<{ default: ImageMetadata }>('../assets/folletos/*.png', { eager: true });
const folleto = p.folleto && {
  href: `/folletos/${p.folleto.pdf}`,
  portada: portadas[`../assets/folletos/${p.folleto.pdf.replace('.pdf', '.png')}`].default,
  info: `${p.folleto.info} · ${(statSync(`public/folletos/${p.folleto.pdf}`).size / 1e6).toFixed(1).replace('.', ',')} MB`,
};
---
<div class:list={['programa', { activo }]} id={p.id} role="tabpanel" aria-labelledby={`tab-${p.id}`} data-aparato={e.aparato}>
  <div class="ficha-cabecera">
    <div class="ficha-texto">
      <p class="ficha-para">{p.para}</p>
      <h3 class="ficha-nombre">{p.nombre}</h3>
      <p class="ficha-lema">{p.lema}</p>
      <ul class="datos">
        {p.datos.map((d) => (
          <li><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check}></svg>{d}</li>
        ))}
      </ul>
      <a class="boton" href="#contacto">{p.cta}</a>
      {folleto && (
        <a class="folleto" href={folleto.href} download>
          <span class="folleto-hoja">
            <Picture src={folleto.portada} alt="" widths={[72, 144]} sizes="72px" formats={formatos} loading="lazy" decoding="async" />
            <svg class="folleto-clip" viewBox="0 0 16 44" fill="none" stroke="#1B2A4A" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 12v20a5 5 0 0 1-10 0V7a3.5 3.5 0 0 1 7 0v23a1.5 1.5 0 0 1-3 0V12"></path></svg>
          </span>
          <span class="folleto-texto"><strong>{t.folleto}</strong><span>{folleto.info}</span></span>
          <svg class="folleto-flecha" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13M6.5 10.5 12 16l5.5-5.5M4 20.5h16"></path></svg>
        </a>
      )}
    </div>

    <div class="escena">
      <div class="progreso" aria-hidden="true">{p.pantallas.map(() => <span><i></i></span>)}</div>
      <div class="caja">
        {e.herr.map(([nombre, x, y, w, r, lado]) => <Herramienta nombre={nombre} x={x} y={y} w={w} r={r} lado={lado} />)}
        <div class={`aparato aparato--${e.aparato}`}>
          <div class="marco">
            <div class="pantalla">
              <ol class="pista" aria-label={t.pantallas}>
                {p.pantallas.map((s) => (
                  <li><Picture src={img(s.img)} alt={s.alt} widths={e.widths} sizes={e.sizes} formats={formatos} loading="lazy" decoding="async" /></li>
                ))}
              </ol>
            </div>
          </div>
          {e.aparato === 'portatil' && <div class="base"></div>}
        </div>
      </div>
      <ol class="lista">
        {p.pantallas.map((s, i) => (
          <li data-activa={i === 0 ? '' : undefined}><button type="button" aria-current={i === 0 ? 'true' : undefined}>{s.t}</button></li>
        ))}
      </ol>
      <p class="pista-texto">{t.pista}</p>
    </div>
  </div>

  <div class="flujo-caja">
    <ol class="flujo" role="list" style={`--n:${p.pasos.length}`}>
      {p.pasos.map((s, i) => <li><span class="flujo-num" aria-hidden="true">{i + 1}</span><strong>{s}</strong></li>)}
    </ol>
  </div>

  <ul class="cifras">
    {p.cifras.map((c) => <li><strong>{c.n}</strong><span>{c.t}</span></li>)}
  </ul>

  {folleto && (
    <div class="mas">
      <p>{t.mas}</p>
      <a class="boton" href={folleto.href} download>{t.folleto}</a>
    </div>
  )}
</div>
