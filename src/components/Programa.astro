---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Herramienta from './Herramienta.astro';
import type { Programa } from '../programas';

type Herr = [string, string, string, string, string, number];
interface Props {
  p: Programa;
  activo: boolean;
  t: { pantallas: string; pista: string; hace: string; antes: string; ahora: string; mas: string };
  escena: { aparato: string; widths: number[]; sizes: string; herr: Herr[] };
  img: (nombre: string) => ImageMetadata;
}
const { p, activo, t, escena: e, img } = Astro.props;
const formatos: ('avif' | 'webp')[] = ['avif', 'webp'];
const check = '<path d="M4 10.5l4 4 8-9"></path>';
---
<div class:list={['programa', { activo }]} id={p.id} role="tabpanel" aria-labelledby={`tab-${p.id}`} data-aparato={e.aparato}>
  <div class="ficha-cabecera">
    <div class="ficha-texto">
      <p class="ficha-para">{p.para}</p>
      <h3 class="ficha-nombre">{p.nombre}</h3>
      <p class="ficha-lema">{p.lema}</p>
      <ul class="datos">
        {p.datos.map((d) => (
          <li><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check}></svg>{d}</li>
        ))}
      </ul>
      <a class="boton" href="#contacto">{p.cta}</a>
    </div>

    <div class="escena">
      <div class="progreso" aria-hidden="true">{p.pantallas.map(() => <span><i></i></span>)}</div>
      <div class="caja">
        {e.herr.map(([nombre, x, y, w, r, lado]) => <Herramienta nombre={nombre} x={x} y={y} w={w} r={r} lado={lado} />)}
        <div class={`aparato aparato--${e.aparato}`}>
          <div class="marco">
            <div class="pantalla">
              <ol class="pista" aria-label={t.pantallas}>
                {p.pantallas.map((s) => (
                  <li><Picture src={img(s.img)} alt={s.alt} widths={e.widths} sizes={e.sizes} formats={formatos} loading="lazy" decoding="async" /></li>
                ))}
              </ol>
            </div>
          </div>
          {e.aparato === 'portatil' && <div class="base"></div>}
        </div>
      </div>
      <ol class="lista">
        {p.pantallas.map((s, i) => (
          <li data-activa={i === 0 ? '' : undefined}><button type="button" aria-current={i === 0 ? 'true' : undefined}>{s.t}</button></li>
        ))}
      </ol>
      <p class="pista-texto">{t.pista}</p>
    </div>
  </div>

  <ol class="flujo" role="list" style={`--n:${p.pasos.length}`}>
    {p.pasos.map((s, i) => <li><span class="flujo-num" aria-hidden="true">{i + 1}</span><strong>{s}</strong></li>)}
  </ol>

  <div class="ficha-detalle">
    <div class="hace">
      <h4>{t.hace}</h4>
      <ul>{p.hace.map((h) => <li>{h}</li>)}</ul>
    </div>
    <div class="antes-ahora">
      <h4><span class="antes-etq">{t.antes}</span> / {t.ahora}</h4>
      <ul>
        {p.antes.map(([a, d]) => <li><s>{a}</s><span>{d}</span></li>)}
      </ul>
    </div>
  </div>

  <ul class="cifras">
    {p.cifras.map((c) => <li><strong>{c.n}</strong><span>{c.t}</span></li>)}
  </ul>

  <div class="mas">
    <p>{t.mas}</p>
    <a class="boton" href="#contacto">{p.cta}</a>
  </div>
</div>
